# AYDA Pi-side HTTP arayuzu
AYDA_WEB_HOST=127.0.0.1
AYDA_WEB_PORT=8090

# Pi tarafindaki uygulama ayarlari
AYDA_SETTINGS_PATH=/opt/pitablet/pi-side/ayda/settings.yaml
PYTHONPATH=/opt/pitablet/pi-side

# Varsayilan entegrasyon: ana makinedeki servis ile konus
AYDA_PC_ENABLED=true
AYDA_LOCAL_ENABLED=false
AYDA_PC_BASE_URL=http://127.0.0.1:7000
